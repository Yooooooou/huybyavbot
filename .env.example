# Telegram bot token from @BotFather
BOT_TOKEN=

# Target chat id where voice messages are sent.
# For a group: add the bot to the group and read the negative chat id
# (e.g. -1001234567890). For a private chat: your own user id.
CHAT_ID=

# --- Optional settings (defaults shown) ---

# Random interval between posts, in minutes.
MIN_INTERVAL_MINUTES=60
MAX_INTERVAL_MINUTES=240

# Quiet hours (24h, local server time). No posts inside this window.
# Example below: silence from 22:00 to 09:00.
QUIET_START_HOUR=22
QUIET_END_HOUR=9

# Clip length bounds, in seconds.
MIN_CLIP_SECONDS=5
MAX_CLIP_SECONDS=15

# Send one clip immediately on startup (useful for testing). true/false.
SEND_ON_STARTUP=false
