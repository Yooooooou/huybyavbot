# Telegram bot token from @BotFather. This is the ONLY required setting.
BOT_TOKEN=

# The bot works in every chat it's added to and finds videos itself, so there
# is no CHAT_ID and nothing else to configure. Everything below is optional.

# --- Optional settings (defaults shown) ---

# Where the bot keeps its state (chat registry, dedup log). On Railway the
# normal filesystem is wiped on every redeploy; mount a Volume (e.g. at /data)
# and set DATA_DIR=/data so the known-chats list survives restarts. Even
# without a volume the bot re-learns a group from its first message after a
# restart (it must be able to see messages - being a group admin guarantees it).
# DATA_DIR=/data

# Random interval between posts, in minutes. Default 5-75, randomized.
MIN_INTERVAL_MINUTES=5
MAX_INTERVAL_MINUTES=75

# Quiet hours (24h, server time). No posts inside this window.
# Disabled by default (equal start == end) -> posts 24/7.
# To silence e.g. 22:00-09:00, set QUIET_START_HOUR=22 and QUIET_END_HOUR=9.
QUIET_START_HOUR=0
QUIET_END_HOUR=0

# Clip length bounds, in seconds.
MIN_CLIP_SECONDS=5
MAX_CLIP_SECONDS=15

# Note: the bot finds videos itself by searching YouTube (keywords in
# queries.json) via yt-dlp - no YouTube API key needed. sources.json is only
# an optional fallback if a search returns nothing.

# --- Getting past YouTube's "confirm you're not a bot" block ---
# On datacenter hosts (Railway, VPS) YouTube often refuses downloads. Two knobs:
#
# 1) Player clients tried by yt-dlp (comma-separated). Sometimes enough on its
#    own. Default: tv,mweb,web_safari,android_vr
# YTDLP_PLAYER_CLIENT=tv,mweb,web_safari,android_vr
#
# 2) Cookies (the reliable fix, esp. on datacenter IPs like Railway). Export
#    YouTube cookies in Netscape format from a logged-in browser (use a THROWAWAY
#    Google account - a datacenter IP can get the account flagged). Two ways:
#    a) Easiest on Railway: paste the whole cookies.txt content into this var.
# YOUTUBE_COOKIES=
#    b) Or point to a cookies file on disk (e.g. on a mounted volume):
# COOKIES_FILE=/data/cookies.txt
#    Guide: https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
